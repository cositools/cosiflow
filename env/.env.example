# Copy to .env, fill every blank value, then run: chmod 600 .env
# Generate local Airflow/database secrets with: python3 bootstrap-secrets.py
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW__WEBSERVER__SECRET_KEY=
AIRFLOW__CORE__INTERNAL_API_SECRET_KEY=
AIRFLOW__CORE__FERNET_KEY=
POSTGRES_PASSWORD=
GCN_DB_PASSWORD=
GCN_MYSQL_ROOT_PASSWORD=
GCN_CLIENT_ID=
GCN_CLIENT_SECRET=

# Non-secret overrides are optional.
# AIRFLOW_ADMIN_USERNAME=admin
# AIRFLOW_ADMIN_EMAIL=admin@localhost
# AIRFLOW_WEBUI_PORT=8080
# MAILHOG_WEBUI_PORT=8025
