# Copy to .env, fill every blank value, then run: chmod 600 .env
# Generate local Airflow/database secrets with: python3 bootstrap-secrets.py
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW__WEBSERVER__SECRET_KEY=
AIRFLOW__CORE__INTERNAL_API_SECRET_KEY=
AIRFLOW__CORE__FERNET_KEY=
POSTGRES_PASSWORD=
GCN_DB_PASSWORD=
GCN_MYSQL_ROOT_PASSWORD=
GCN_CLIENT_ID=
GCN_CLIENT_SECRET=

# Non-secret overrides are optional.
# AIRFLOW_ADMIN_USERNAME=admin
# AIRFLOW_ADMIN_EMAIL=admin@localhost
# AIRFLOW_WEBUI_PORT=8080
# MAILHOG_WEBUI_PORT=8025
# GCN_WORKER_BACKOFF_INITIAL_SECONDS=1
# GCN_WORKER_BACKOFF_MAX_SECONDS=30
# GCN_WORKER_BACKOFF_JITTER_RATIO=0.2
# GCN_WORKER_FAILURE_BUDGET=5
# GCN_OUTBOX_RETRY_INITIAL_SECONDS=5
# GCN_OUTBOX_RETRY_MAX_SECONDS=300
# GCN_OUTBOX_LOCK_TIMEOUT_SECONDS=300
# GCN_HEARTBEAT_DEGRADED_SECONDS=30
# GCN_HEARTBEAT_OFFLINE_SECONDS=90
# GCN_WATCHDOG_INTERVAL_SECONDS=5
# GCN_WATCHDOG_START_GRACE_SECONDS=30
